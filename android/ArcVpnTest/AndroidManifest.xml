<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.chromium.arc.testapp.arcvpn">
  <!-- Otherwise the system will kill the service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

  <application>
    <service android:name="org.chromium.arc.testapp.arcvpn.ArcTestVpnService"
             android:permission="android.permission.BIND_VPN_SERVICE"
             android:exported="true">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
    </service>
    <receiver android:name="org.chromium.arc.testapp.arcvpn.VpnLaunchReceiver"
              android:exported="true">
      <intent-filter>
        <action android:name="org.chromium.arc.testapp.arcvpn.LAUNCH_VPN" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
