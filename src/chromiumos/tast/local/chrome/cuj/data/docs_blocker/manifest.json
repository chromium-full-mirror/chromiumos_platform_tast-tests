{
  "key": "",
  "manifest_version": 2,
  "name": "Docs Blocker For Test",
  "version": "0.1",
  "description": "Blocks Docs network requests to force offline mode for test",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://docs.google.com/",
    "*://*.gstatic.com/"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
