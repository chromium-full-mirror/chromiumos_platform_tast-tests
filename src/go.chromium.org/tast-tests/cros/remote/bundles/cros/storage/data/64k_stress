;
; 64k random with verify and mix read write.
;

[64k_stress]

readwrite=randrw
bs=64K
ioengine=libaio
iodepth=32
direct=1
threads=8
rwmixread=15

time_based
bwavgtime=5000
iopsavgtime=5000

do_verify=1
verify=meta
verify_interval=4k