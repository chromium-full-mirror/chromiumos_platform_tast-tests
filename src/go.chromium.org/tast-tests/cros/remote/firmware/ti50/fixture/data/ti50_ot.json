  "strappings": [
    /*
     * Assert PLT_RST_L to enable the SPI/I2C tpm.
     */
    {
      "name": "AP_ON_I2C",
      "pins": [
	{
	  "name": "PLT_RST_L",
	  "level": true
	}
      ]
    },
    {
      "name": "AP_ON_SPI",
      "pins": [
	{
	  "name": "PLT_RST_L",
	  "level": true
	}
      ]
    },
    /*
     * Deassert PLT_RST_L to disable the SPI/I2C tpm.
     */
    {
      "name": "AP_OFF",
      "pins": [
	{
	  "name": "PLT_RST_L",
	  "level": false
	}
      ]
    },
    {
