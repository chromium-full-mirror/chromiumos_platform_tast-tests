set noparent

# Tast team for bulk updates/emergencies.
include /OWNERS.tast

include chromiumos/owners:v1:/kernel/OWNERS.all

# Remove kernel owners from `config_verify.go`, but still allow tast
# team for bulk updates/emergencies.
per-file config_verify.go=set noparent
per-file config_verify.go=file:/OWNERS.tast
per-file config_verify.go=file:chromiumos/owners:v1:/security/OWNERS.hardening
