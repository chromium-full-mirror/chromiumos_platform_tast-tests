steps {
  cardinality {
    type: ALL_IN_ORDER
  }
  expectation_with_response {
    expectation {
      ipp_matcher {
        # `create-job`
        #operation_id: 0x0005
        # `validate-job`
        operation_id: 0x0004
        groups {
          tag: OPERATION_ATTRIBUTES
          collections {
            attributes {
              name: "attributes-charset"
              type: CHARSET
              string_values { string_values { value: "utf-8" } }
            }
            attributes {
              name: "attributes-natural-language"
              type: NATURAL_LANGUAGE
              string_values { string_values { value: "en-us" } }
            }
            attributes {
              name: "printer-uri"
              type: URI
              string_values { string_values { value: "ipp://%2Frun%2Fippusb%2F18d1-505e.sock:631/ipp/print" } }
            }
            attributes {
              name: "requesting-user-name"
              type: NAME_WITHOUT_LANGUAGE
              string_values { string_values { value: "chronos" } }
            }
            attributes {
              name: "job-name"
              type: NAME_WITHOUT_LANGUAGE
              string_values { string_values { value: "Untitled" } }
            }
            attributes {
              name: "document-format"
              type: MIME_MEDIA_TYPE
              string_values { string_values { value: "application/pdf" } }
            }
          }
        }
        groups {
          tag: JOB_ATTRIBUTES
          collections {
            attributes {
              name: "media-col"
              type: BEGIN_COLLECTION
              collections { collections {
                attributes {
                  name: "media-size"
                  type: BEGIN_COLLECTION
                  collections { collections {
                    attributes {
                      name: "x-dimension"
                      type: INTEGER
                      int_values { int_values: 21000 }
                    }
                    attributes {
                      name: "y-dimension"
                      type: INTEGER
                      int_values { int_values: 29700 }
                    }
                  } }
                }
                attributes {
                  name: "media-bottom-margin"
                  type: INTEGER
                  int_values { int_values: 0 }
                }
                attributes {
                  name: "media-left-margin"
                  type: INTEGER
                  int_values { int_values: 0 }
                }
                attributes {
                  name: "media-right-margin"
                  type: INTEGER
                  int_values { int_values: 0 }
                }
                attributes {
                  name: "media-top-margin"
                  type: INTEGER
                  int_values { int_values: 0 }
                }
                attributes {
                  name: "media-type"
                  type: KEYWORD
                  string_values { string_values { value: "photographic" } }
                }
              } }
            }
            attributes {
              name: "output-bin"
              type: KEYWORD
              string_values { string_values { value: "face-down" } }
            }
            attributes {
              name: "print-color-mode"
              type: KEYWORD
              string_values { string_values { value: "auto-monochrome" } }
            }
            attributes {
              name: "print-quality"
              type: ENUM
              int_values { int_values: 4 }
            }
            attributes {
              name: "sides"
              type: KEYWORD
              string_values { string_values { value: "one-sided" } }
            }
            attributes {
              name: "multiple-document-handling"
              type: KEYWORD
              string_values { string_values { value: "separate-documents-collated-copies" } }
            }

          }

        }
      }
    }
    response {
      default_response: true
    }
  }
  expectation_with_response {
    expectation {
      ipp_matcher {
        # `create-job`
        operation_id: 0x0005
        groups {
          tag: OPERATION_ATTRIBUTES
          collections {
            attributes {
              name: "attributes-charset"
              type: CHARSET
              string_values { string_values { value: "utf-8" } }
