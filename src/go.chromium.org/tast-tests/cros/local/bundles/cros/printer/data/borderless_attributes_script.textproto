# proto-file:
# third_party/virtual-usb-printer/mock_printer/proto/control_flow.proto
# proto-message: mocking.TestCase

# Instructs the mock printer to wait for the series of requests that lpadmin
# sends to set up the printer. After that, it waits for cupsd to set up and
# send the print job with a media type of "photographic" and all four margins
# set to zero, indicating borderless printing. Finally, handle all of the
# requests sent to the virtual-usb-printer when cupsd is polling the status
# of the print job.

steps {
  cardinality {
    type: SOME_OF
    count { at_least: 1 }
  }
  expectation_with_response {
    expectation {
      ipp_matcher {
        # `get-printer-attributes`
        operation_id: 0x000b
        groups {
          tag: OPERATION_ATTRIBUTES
          collections {
            attributes {
              name: "attributes-charset"
              type: CHARSET
              string_values { string_values { value: "utf-8" } }
            }
            attributes {
              name: "attributes-natural-language"
              type: NATURAL_LANGUAGE
              string_values { string_values { value: "en-us" } }
            }
            attributes {
              name: "printer-uri"
              type: URI
              string_values { string_values { value: "ipp://18d1_505e/ipp/print" } }
            }
            attributes {
              name: "requested-attributes"
              type: KEYWORD
              string_values { string_values { value: "document-format-supported" } }
            }
          }
        }
      }
    }
    response {
      default_response: true
    }
  }
  expectation_with_response {
    expectation {
      ipp_matcher {
        # `get-printer-attributes`
        operation_id: 0x000b
        groups {
          tag: OPERATION_ATTRIBUTES
          collections {
            attributes {
              name: "attributes-charset"
              type: CHARSET
              string_values { string_values { value: "utf-8" } }
            }
            attributes {
              name: "attributes-natural-language"
              type: NATURAL_LANGUAGE
              string_values { string_values { value: "en-us" } }
            }
            attributes {
              name: "printer-uri"
              type: URI
              string_values { string_values { value: "ipp://18d1_505e/ipp/print" } }
            }
            attributes {
              name: "document-format"
              type: MIME_MEDIA_TYPE
              string_values { string_values { value: "application/pdf" } }
            }
          }
        }
      }
    }
    response {
      default_response: true
    }
  }
  expectation_with_response {
    expectation {
      ipp_matcher {
        # `get-printer-attributes`
        operation_id: 0x000b
        groups {
          tag: OPERATION_ATTRIBUTES
          collections {
            attributes {
              name: "attributes-charset"
              type: CHARSET
              string_values { string_values { value: "utf-8" } }
            }
            attributes {
              name: "attributes-natural-language"
              type: NATURAL_LANGUAGE
              string_values { string_values { value: "en" } }
            }
            attributes {
              name: "printer-uri"
              type: URI
              string_values { string_values { value: "ipp://18d1_505e/ipp/print" } }
            }
            attributes {
              name: "requested-attributes"
              type: KEYWORD
              string_values { string_values { value: "printer-strings-uri" } }
            }
          }
        }
      }
    }
    response {
      default_response: true
    }
  }
  expectation_with_response {
    expectation {
      ipp_matcher {
        # `get-printer-attributes`
        operation_id: 0x000b
        groups {
          tag: OPERATION_ATTRIBUTES
          collections {
            attributes {
              name: "attributes-charset"
              type: CHARSET
              string_values { string_values { value: "utf-8" } }
            }
