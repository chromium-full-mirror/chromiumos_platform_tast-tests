                string_values { value: "printer-requested-client-type" }
                string_values { value: "printer-state" }
                string_values { value: "printer-state-message" }
                string_values { value: "printer-state-reasons" }
              }
            }
          }
        }
      }
    }
    response {
      default_response: true
    }
