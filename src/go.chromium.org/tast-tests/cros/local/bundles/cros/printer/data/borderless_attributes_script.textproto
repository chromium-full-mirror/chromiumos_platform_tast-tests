              type: NATURAL_LANGUAGE
              string_values { string_values { value: "en-us" } }
            }
            attributes {
              name: "printer-uri"
              type: URI
              string_values { string_values { value: "ipp://%2Frun%2Fippusb%2F18d1-505e.sock:631/ipp/print" } }
            }
            attributes {
              name: "requested-attributes"
              type: KEYWORD
              string_values {
                string_values { value: "client-info-supported" }
                string_values { value: "compression-supported" }
                string_values { value: "copies-supported" }
                string_values { value: "cups-version" }
                string_values { value: "document-format-supported" }
                string_values { value: "job-password-encryption-supported" }
                string_values { value: "marker-colors" }
                string_values { value: "marker-high-levels" }
                string_values { value: "marker-levels" }
                string_values { value: "marker-low-levels" }
                string_values { value: "marker-message" }
                string_values { value: "marker-names" }
                string_values { value: "marker-types" }
                string_values { value: "max-client-info-supported" }
                string_values { value: "media-col-supported" }
                string_values { value: "multiple-document-handling-supported" }
                string_values { value: "operations-supported" }
                string_values { value: "print-color-mode-supported" }
                string_values { value: "printer-alert" }
