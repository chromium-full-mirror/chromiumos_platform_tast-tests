{
  "manifest_version": 3,
  "name": "FuseboxFSP",
  "description": "Fusebox File System Provider Tast Extension",
  "version": "0.0.1",
  "permissions": [
    "identity",
    "fileSystemProvider"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "file_system_provider_capabilities": {
    "multiple_mounts": false,
    "source": "network",
    "watchable": false
  }
}
