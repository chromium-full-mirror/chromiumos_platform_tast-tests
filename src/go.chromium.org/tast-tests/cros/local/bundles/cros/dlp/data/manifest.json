{
  "background": {
    "persistent": false,
    "service_worker": "background.js"
  },
  "commands": {
    "undo": {
      "description": "A test command which doesn't affect clipboard content",
      "suggested_key": {
        "default": "Ctrl+Z"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "description": "For testing the DLP clipboard restriction",
  "key": "",
  "manifest_version": 3,
  "name": "DLP extension to get clipboard data",
  "permissions": [
    "clipboardRead"
  ],
  "version": "0.1"
}
