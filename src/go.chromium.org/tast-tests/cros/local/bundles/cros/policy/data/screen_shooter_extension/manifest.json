{
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "takeScreenshot": {
      "description": "Take screenshot",
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "description": "Take screenshots with ALL the APIs",
  "host_permissions": [
    "<all_urls>"
  ],
  "key": "",
  "manifest_version": 3,
  "name": "Screenshooter",
  "permissions": [
    "desktopCapture",
    "tabCapture",
    "scripting"
  ],
  "version": "1.1"
}
